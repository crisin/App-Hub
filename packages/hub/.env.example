# App Hub — Environment Configuration
# Copy to .env and customize as needed.
# All values have sensible defaults — none are required.

# Server
APPHUB_PORT=5174
APPHUB_HOST=localhost

# Paths (relative to monorepo root, or absolute)
# APPHUB_DB_PATH=./packages/hub/data/apphub.db
# APPHUB_PROJECTS_DIR=./projects
# APPHUB_TEMPLATES_DIR=./templates
# APPHUB_LOG_DIR=./logs

# Self-modification (Phase 3) — default: false
# APPHUB_SELF_MODIFY=false

# Runner concurrency — max parallel Claude tasks (Phase 2)
# APPHUB_MAX_CONCURRENT=2

# Runner mode: cli (default, uses Claude CLI) or api (uses Anthropic SDK)
# APPHUB_RUNNER_MODE=cli

# ── Local AI agents ─────────────────────────────────────────────────

# Ollama server (openai-compatible endpoint is derived automatically)
# APPHUB_OLLAMA_URL=http://127.0.0.1:11434

# Generic OpenAI-compatible server (LM Studio, llama.cpp, vLLM, ...)
# APPHUB_OPENAI_COMPAT_URL=http://127.0.0.1:1234
# APPHUB_OPENAI_COMPAT_KEY=

# Agent definitions directory (markdown files with frontmatter)
# APPHUB_AGENTS_DIR=./agents

# Model for the aider coder backend (board items labeled "aider")
# APPHUB_AIDER_MODEL=ollama_chat/qwen3-coder:30b

# Anthropic API — enables the "anthropic" agent provider
# ANTHROPIC_API_KEY=
