# App Hub — Environment Configuration
# Copy to .env and customize as needed.
# All values have sensible defaults — none are required.

# Server
APPHUB_PORT=5174
APPHUB_HOST=localhost

# Paths — resolved in packages/hub/src/lib/server/config.ts.
# Relative values resolve against the hub root; absolute paths work too.
# APPHUB_ROOT=            # only if auto-detection fails (walks up to package.json "apphub")
# APPHUB_PROJECTS_DIR=./projects
# APPHUB_TEMPLATES_DIR=./templates
# APPHUB_AGENTS_DIR=./agents
# APPHUB_LOG_DIR=./logs
# APPHUB_DATA_DIR=./packages/hub/data      # SQLite index + attachments
# APPHUB_DB_PATH=./packages/hub/data/apphub.db

# Projects outside projects/ — path-delimiter separated (";" on Windows, ":" elsewhere).
# Usually you register them instead: `npm run cli -- register <path>` writes the
# machine-local apphub.local.json (gitignored).
# APPHUB_PROJECT_PATHS=

# ── Local AI agents ─────────────────────────────────────────────────

# Ollama server (openai-compatible endpoint is derived automatically)
# APPHUB_OLLAMA_URL=http://127.0.0.1:11434

# Generic OpenAI-compatible server (LM Studio, llama.cpp, vLLM, ...)
# APPHUB_OPENAI_COMPAT_URL=http://127.0.0.1:1234
# APPHUB_OPENAI_COMPAT_KEY=

# Models for the aider coder backend (board items labeled "aider").
# Weak/editor model default to the main model — pin them to models that
# actually exist locally, or aider retry-loops on 404s.
# APPHUB_AIDER_MODEL=ollama_chat/qwen3-coder:30b
# APPHUB_AIDER_WEAK_MODEL=
# APPHUB_AIDER_EDITOR_MODEL=

# Anthropic API — enables the "anthropic" agent provider
# ANTHROPIC_API_KEY=
