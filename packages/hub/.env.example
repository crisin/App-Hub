# App Hub — Environment Configuration
# Copy to .env and customize as needed.
# All values have sensible defaults — none are required.

# Server
APPHUB_PORT=5174
APPHUB_HOST=localhost

# Paths (relative to monorepo root, or absolute)
# APPHUB_DB_PATH=./packages/hub/data/apphub.db
# APPHUB_PROJECTS_DIR=./projects
# APPHUB_TEMPLATES_DIR=./templates
# APPHUB_LOG_DIR=./logs

# Self-modification (Phase 3) — default: false
# APPHUB_SELF_MODIFY=false

# Runner concurrency — max parallel Claude tasks (Phase 2)
# APPHUB_MAX_CONCURRENT=2

# Runner mode: cli (default, uses Claude CLI) or api (uses Anthropic SDK)
# APPHUB_RUNNER_MODE=cli

# Anthropic API (only needed if APPHUB_RUNNER_MODE=api)
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-20250514
